# TOTM Trust API settings. Copy to .env for local runs; set the same names in Vercel (Settings > Environment Variables).
# Secrets: never commit .env.

# --- Issuer registry (on-chain, IssuerRegistryV2) ---
REGISTRY_CHAIN_ID=11155111
# Address printed by "npm run contract:deploy" (also saved in deployments/<chainId>.json)
REGISTRY_ADDRESS=
# RPC: either a full URL, or INFURA_API_KEY for Sepolia
REGISTRY_RPC_URL=
INFURA_API_KEY=
# Only for the CLI (deploy / registry add ...). Never set this on Vercel.
REGISTRY_OWNER_PRIVATE_KEY=

# --- eLC status store (Upstash Redis REST). Without it (local only) records live in memory. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Inbox file storage: Vercel Blob, PRIVATE store. Without it: memory locally, inbox off (503) when hosted. ---
# Vercel project > Storage > Create > Blob > access Private, connect to the project. On Vercel the SDK then authenticates
# by itself (OIDC + BLOB_STORE_ID). For local runs against the real store: "vercel env pull" or set the token below.
BLOB_READ_WRITE_TOKEN=
# Max file size in MB (Vercel caps request bodies at 4.5 MB) and days a file is kept
INBOX_MAX_MB=4
INBOX_TTL_DAYS=30

# --- Issuing banks' signing keys (SECRET). TrustVC key pair JSON, or an array of them. Create with "npm run bank-key",
# or reuse the VC Layer's demo bank (its ISSUER_KEY_JSON / data/issuer-key.json) so both issue as the same DID.
BANK_KEYS_JSON=

# --- API keys: hashes only. Admin: "npm run keygen -- --admin". Partners normally self-register with an OTP
# ("npm run partner -- otp …"); PARTNER_API_KEYS is only for manually created keys ("npm run keygen -- --name …").
# JSON array, one entry per partner: [{"name":"PILA","did":"did:nda:testnet:0x…","type":"verifier","keyHash":"<sha256 hex>"}]
PARTNER_API_KEYS=
ADMIN_API_KEY_HASH=

# --- PILA verification (POST /api/v1/pila/verify): pila-verifier/ runs PILA's Go SDK + NDAKey's verification context.
# The API starts bin/pila-verifier itself (built by the Dockerfile on Railway; locally "npm run pila:build").
PILA_PARTNER_API_KEY=
# PILA_NDAKEY_URL=https://api-beta.ndakey.vn/service/api/v1
# PILA_DID_RESOLVER_URL=https://api.ndadid.vn/api/v1/did
# Use a verifier running elsewhere instead (e.g. "go run ." in pila-verifier/): PILA_VERIFIER_URL + PILA_VERIFIER_TOKEN
# PILA_VERIFIER_URL=
# PILA_VERIFIER_TOKEN=
# PILA_VERIFIER=off

# --- Only for "npm run elc" (admin client) ---
TRUST_API_URL=http://127.0.0.1:4300
ADMIN_API_KEY=

PORT=4300
LOG_LEVEL=info
