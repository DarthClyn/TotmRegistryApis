# TOTM Trust API settings. Copy to .env for local runs; set the same names in Vercel (Settings > Environment Variables).
# Secrets: never commit .env.

# --- Issuer registry (on-chain, IssuerRegistryV2) ---
REGISTRY_CHAIN_ID=11155111
# Address printed by "npm run contract:deploy" (also saved in deployments/<chainId>.json)
REGISTRY_ADDRESS=
# RPC: either a full URL, or INFURA_API_KEY for Sepolia
REGISTRY_RPC_URL=
INFURA_API_KEY=
# Only for the CLI (deploy / registry add ...). Never set this on Vercel.
REGISTRY_OWNER_PRIVATE_KEY=

# --- eLC status store (Upstash Redis REST). Without it (local only) records live in memory. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Issuing banks' signing keys (SECRET). TrustVC key pair JSON, or an array of them. Create with "npm run bank-key",
# or reuse the VC Layer's demo bank (its ISSUER_KEY_JSON / data/issuer-key.json) so both issue as the same DID.
BANK_KEYS_JSON=

# --- API keys: hashes only. Admin: "npm run keygen -- --admin". Partners normally self-register with an OTP
# ("npm run partner -- otp …"); PARTNER_API_KEYS is only for manually created keys ("npm run keygen -- --name …").
# JSON array, one entry per partner: [{"name":"PILA","did":"did:nda:testnet:0x…","type":"verifier","keyHash":"<sha256 hex>"}]
PARTNER_API_KEYS=
ADMIN_API_KEY_HASH=

# --- Only for "npm run elc" (admin client) ---
TRUST_API_URL=http://127.0.0.1:4300
ADMIN_API_KEY=

PORT=4300
LOG_LEVEL=info
